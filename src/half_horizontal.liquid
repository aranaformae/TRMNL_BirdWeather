{% assign last = IDX_0.detections | first %}
{% assign settings = trmnl.plugin_settings.custom_fields_values %}
{% assign language = settings.bird_language | default: 'nl' %}
{% assign period_key = settings.period | default: 'day' %}
{% capture period_label %}{% render 'bw_text', language: language, key: period_key %}{% endcapture %}
{% assign period_label = period_label | strip %}

<style>
  .bwh {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: start;
    gap: 14px;
    width: 100%;
    min-width: 0;
    text-align: left;
  }
  .bwh-left, .bwh-right {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }
  .bwh-heading {
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
  }
  .bwh-hero {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
  }
  .bwh-photo {
    display: block;
    width: 60px;
    height: 60px;
    object-fit: contain;
  }
  .bwh-details {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .bwh-name {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  .bwh-time {
    font-size: 11px;
    line-height: 1.2;
  }
  .bwh-scientific, .bwh-confidence {
    display: none;
  }
  .bwh-totals {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding-top: 6px;
    border-top: 1px solid black;
  }
  .bwh-number {
    font-size: 26px;
    font-weight: 700;
    line-height: 1;
  }
  .bwh-caption {
    font-size: 12px;
    line-height: 1.2;
  }
  .bwh-row {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr) 42px;
    align-items: center;
    gap: 6px;
    padding: 3px 0;
    border-bottom: 1px solid black;
  }
  .bwh-rank {
    font-size: 12px;
    line-height: 1.1;
  }
  .bwh-species {
    min-width: 0;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.1;
  }
  .bwh-count {
    text-align: right;
    white-space: nowrap;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.1;
  }
  .bwh-share, .bwh-recent, .bwh-note {
    display: none;
  }
  .bwh-row.bwh-extra {
    display: none;
  }
  @media (min-width: 1000px) {
    .bwh {
      gap: 28px;
    }
    .bwh-left, .bwh-right {
      gap: 10px;
    }
    .bwh-heading {
      font-size: 14px;
    }
    .bwh-hero {
      grid-template-columns: 130px minmax(0, 1fr);
      gap: 16px;
    }
    .bwh-photo {
      width: 130px;
      height: 115px;
    }
    .bwh-details {
      gap: 5px;
    }
    .bwh-name {
      font-size: 27px;
    }
    .bwh-time {
      font-size: 13px;
    }
    .bwh-scientific, .bwh-confidence {
      display: block;
      font-size: 13px;
      line-height: 1.2;
    }
    .bwh-totals {
      padding-top: 10px;
    }
    .bwh-number {
      font-size: 32px;
    }
    .bwh-caption {
      font-size: 14px;
    }
    .bwh-row {
      grid-template-columns: 20px minmax(0, 1fr) 52px 48px;
      gap: 10px;
      padding: 5px 0;
    }
    .bwh-species, .bwh-count {
      font-size: 18px;
    }
    .bwh-share {
      display: block;
      text-align: right;
      white-space: nowrap;
      font-size: 13px;
    }
    .bwh-row.bwh-extra {
      display: grid;
    }
    .bwh-recent {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .bwh-recent-row {
      display: grid;
      grid-template-columns: 46px minmax(0, 1fr) 38px;
      gap: 8px;
      font-size: 13px;
      line-height: 1.2;
    }
    .bwh-note {
      display: block;
      font-size: 12px;
      line-height: 1.2;
    }
  }
</style>

<div class="layout">
  {% if IDX_0.success == true and IDX_1.success == true and IDX_2.success == true %}
    <div class="bwh">
      <div class="bwh-left">
        <span class="bwh-heading">
          {% render 'bw_text', language: language, key: 'last' %}
        </span>

        {% if last %}
          {% assign photo = last.species.imageUrl %}
          {% if photo == blank %}
            {% assign photo = last.species.thumbnailUrl %}
          {% endif %}

          <div class="bwh-hero">
            {% if photo != blank %}
              <img
                src="{{ photo | escape }}"
                alt="{{ last.species.commonName | escape }}"
                class="image image-dither bwh-photo"
              >
            {% else %}
              <span></span>
            {% endif %}

            <div class="bwh-details">
              <span class="bwh-name" data-clamp="2">
                {{ last.species.commonName | escape }}
              </span>

              <span class="bwh-scientific" data-clamp="1">
                {{ last.species.scientificName | escape }}
              </span>

              <span class="bwh-time">
                {{ last.timestamp | date: "%d-%m %H:%M %z" }}
              </span>

              {% if last.confidence != nil %}
                <span class="bwh-confidence">
                  {% render 'bw_text', language: language, key: 'confidence' %}:
                  {{ last.confidence | times: 100 | round }}%
                </span>
              {% endif %}
            </div>
          </div>
        {% else %}
          <span class="bwh-caption">
            {% render 'bw_text', language: language, key: 'empty' %}
          </span>
        {% endif %}

        <div class="bwh-totals">
          <div>
            <div class="bwh-number">{{ IDX_2.species }}</div>
            <div class="bwh-caption">
              {% render 'bw_text', language: language, key: 'species' %} ·
              {{ period_label | escape }}
            </div>
          </div>
          <div>
            <div class="bwh-number">{{ IDX_2.detections }}</div>
            <div class="bwh-caption">
              {% render 'bw_text', language: language, key: 'detections' %} ·
              {{ period_label | escape }}
            </div>
          </div>
        </div>

        <div class="bwh-recent">
          <span class="bwh-heading">
            {% render 'bw_text', language: language, key: 'recent' %} ·
            {% render 'bw_text', language: language, key: 'confidence' %}
          </span>

          {% for detection in IDX_0.detections limit: 3 %}
            <div class="bwh-recent-row">
              <span>{{ detection.timestamp | date: "%H:%M" }}</span>
              <span data-clamp="1">
                {{ detection.species.commonName | escape }}
              </span>
              <span style="text-align: right;">
                {% if detection.confidence != nil %}
                  {{ detection.confidence | times: 100 | round }}%
                {% else %}
                  —
                {% endif %}
              </span>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="bwh-right">
        <span class="bwh-heading">
          {% render 'bw_text', language: language, key: 'top' %} ·
          {{ period_label | escape }}
        </span>

        {% assign total = IDX_2.detections | plus: 0 %}

        {% for bird in IDX_1.species limit: 7 %}
          {% assign count = bird.detections.total | plus: 0 %}
          {% assign share = 0 %}
          {% if total > 0 %}
            {% assign share = count | times: 100.0 | divided_by: total | round: 1 %}
          {% endif %}

          <div class="bwh-row {% if forloop.index > 5 %}bwh-extra{% endif %}">
            <span class="bwh-rank">{{ forloop.index }}</span>
            <span class="bwh-species" data-clamp="1">
              {{ bird.commonName | escape }}
            </span>
            <span class="bwh-count">{{ count }}×</span>
            <span class="bwh-share">{{ share }}%</span>
          </div>
        {% else %}
          <span class="bwh-caption">
            {% render 'bw_text', language: language, key: 'empty_period' %}
          </span>
        {% endfor %}

        <span class="bwh-note">
          {% render 'bw_text', language: language, key: 'count_note' %}
        </span>
      </div>
    </div>
  {% else %}
    <span class="description">
      {% render 'bw_text', language: language, key: 'error' %}
    </span>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">
    BirdWeather · {{ settings.station_name | escape }}
  </span>
  <span class="instance">{{ period_label | escape }}</span>
</div>