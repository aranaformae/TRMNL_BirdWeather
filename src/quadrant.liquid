{% assign last = IDX_0.detections | first %}
{% assign settings = trmnl.plugin_settings.custom_fields_values %}
{% assign language = settings.bird_language | default: 'nl' %}
{% assign period_key = settings.period | default: 'day' %}
{% capture period_label %}{% render 'bw_text', language: language, key: period_key %}{% endcapture %}
{% assign period_label = period_label | strip %}

<style>
  .bwq-container {
    container-type: inline-size;
    container-name: birdweather-quadrant;
  }
  .bwq {
    display: flex;
    flex-direction: column;
    gap: 7px;
    width: 100%;
    min-width: 0;
    text-align: left;
  }
  .bwq-heading {
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
  }
  .bwq-hero {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
  }
  .bwq-photo {
    display: block;
    width: 58px;
    height: 58px;
    object-fit: contain;
  }
  .bwq-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .bwq-name {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  .bwq-small {
    font-size: 11px;
    line-height: 1.2;
  }
  .bwq-totals {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding-top: 6px;
    border-top: 1px solid black;
  }
  .bwq-number {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.1;
  }
  .bwq-confidence, .bwq-ranking {
    display: none;
  }
  @container birdweather-quadrant (min-width: 450px) {
    .bwq {
      gap: 9px;
    }
    .bwq-hero {
      grid-template-columns: 85px minmax(0, 1fr);
      gap: 12px;
    }
    .bwq-photo {
      width: 85px;
      height: 75px;
    }
    .bwq-name {
      font-size: 23px;
    }
    .bwq-heading, .bwq-small {
      font-size: 12px;
    }
    .bwq-confidence {
      display: block;
      font-size: 12px;
      line-height: 1.2;
    }
    .bwq-number {
      font-size: 28px;
    }
    .bwq-ranking {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .bwq-row {
      display: grid;
      grid-template-columns: 16px minmax(0, 1fr) 45px;
      align-items: center;
      gap: 7px;
      padding: 3px 0;
      border-bottom: 1px solid black;
    }
    .bwq-species {
      min-width: 0;
      font-size: 14px;
      font-weight: 600;
      line-height: 1.1;
    }
    .bwq-count {
      font-size: 14px;
      font-weight: 700;
      text-align: right;
      white-space: nowrap;
    }
  }
</style>

<div class="layout bwq-container">
  {% if IDX_0.success == true and IDX_1.success == true and IDX_2.success == true %}
    <div class="bwq">
      <span class="bwq-heading">
        {% render 'bw_text', language: language, key: 'last' %}
      </span>

      {% if last %}
        {% assign photo = last.species.thumbnailUrl %}
        {% if photo == blank %}
          {% assign photo = last.species.imageUrl %}
        {% endif %}

        <div class="bwq-hero">
          {% if photo != blank %}
            <img
              src="{{ photo | escape }}"
              alt="{{ last.species.commonName | escape }}"
              class="image image-dither bwq-photo"
            >
          {% else %}
            <span></span>
          {% endif %}

          <div class="bwq-details">
            <span class="bwq-name" data-clamp="2">
              {{ last.species.commonName | escape }}
            </span>

            <span class="bwq-small">
              {{ last.timestamp | date: "%d-%m %H:%M %z" }}
            </span>

            {% if last.confidence != nil %}
              <span class="bwq-confidence">
                {% render 'bw_text', language: language, key: 'confidence' %}:
                {{ last.confidence | times: 100 | round }}%
              </span>
            {% endif %}
          </div>
        </div>
      {% else %}
        <span class="bwq-small">
          {% render 'bw_text', language: language, key: 'empty' %}
        </span>
      {% endif %}

      <div class="bwq-totals">
        <div>
          <div class="bwq-number">{{ IDX_2.species }}</div>
          <div class="bwq-small">
            {% render 'bw_text', language: language, key: 'species' %} ·
            {{ period_label | escape }}
          </div>
        </div>
        <div>
          <div class="bwq-number">{{ IDX_2.detections }}</div>
          <div class="bwq-small">
            {% render 'bw_text', language: language, key: 'detections' %} ·
            {{ period_label | escape }}
          </div>
        </div>
      </div>

      <div class="bwq-ranking">
        <span class="bwq-heading">
          {% render 'bw_text', language: language, key: 'top' %} · 3 ·
          {{ period_label | escape }}
        </span>

        {% for bird in IDX_1.species limit: 3 %}
          <div class="bwq-row">
            <span class="bwq-small">{{ forloop.index }}</span>
            <span class="bwq-species" data-clamp="1">
              {{ bird.commonName | escape }}
            </span>
            <span class="bwq-count">
              {{ bird.detections.total }}×
            </span>
          </div>
        {% else %}
          <span class="bwq-small">
            {% render 'bw_text', language: language, key: 'empty_period' %}
          </span>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <span class="description">
      {% render 'bw_text', language: language, key: 'error' %}
    </span>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">BirdWeather</span>
  <span class="instance">{{ period_label | escape }}</span>
</div>