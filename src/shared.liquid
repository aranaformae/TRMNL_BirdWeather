{% template bw_text %}
  {%- assign language = language | default: 'nl' -%}

  {%- case language -%}
    {%- when 'en' -%}
      {%- assign words = 'LAST HEARD|Species|Detections|Confidence|RECENT|TOP SPECIES|TOTALS|Day|Week|Month|All|No bird detections yet.|No detections in this period.|BirdWeather unavailable. Check your station ID.|Counts are acoustic detections.|Bird detections|Independent of the selected statistics period.' | split: '|' -%}

    {%- when 'de' -%}
      {%- assign words = 'ZULETZT GEHÖRT|Arten|Erkennungen|Konfidenz|ZULETZT|HÄUFIGSTE ARTEN|GESAMT|Tag|Woche|Monat|Alle|Noch keine Vogelerkennungen.|Keine Erkennungen in diesem Zeitraum.|BirdWeather nicht verfügbar. Stations-ID prüfen.|Gezählt werden akustische Erkennungen.|Vogelerkennungen|Unabhängig vom gewählten Statistikzeitraum.' | split: '|' -%}

    {%- when 'fr' -%}
      {%- assign words = 'DERNIER OISEAU ENTENDU|Espèces|Détections|Confiance|RÉCENTES|ESPÈCES DOMINANTES|TOTAUX|Jour|Semaine|Mois|Tout|Aucune détection pour le moment.|Aucune détection sur cette période.|BirdWeather indisponible. Vérifiez l’identifiant de la station.|Les nombres représentent des détections acoustiques.|Détections d’oiseaux|Indépendamment de la période statistique choisie.' | split: '|' -%}

    {%- when 'es' -%}
      {%- assign words = 'ÚLTIMA AVE OÍDA|Especies|Detecciones|Confianza|RECIENTES|ESPECIES PRINCIPALES|TOTALES|Día|Semana|Mes|Todo|Todavía no hay detecciones.|Sin detecciones en este periodo.|BirdWeather no disponible. Comprueba el ID de la estación.|Las cifras son detecciones acústicas.|Detecciones de aves|Independientemente del periodo estadístico seleccionado.' | split: '|' -%}

    {%- when 'it' -%}
      {%- assign words = 'ULTIMO UCCELLO SENTITO|Specie|Rilevamenti|Affidabilità|RECENTI|SPECIE PRINCIPALI|TOTALI|Giorno|Settimana|Mese|Tutto|Nessun rilevamento per ora.|Nessun rilevamento in questo periodo.|BirdWeather non disponibile. Controlla l’ID della stazione.|I numeri indicano rilevamenti acustici.|Rilevamenti di uccelli|Indipendentemente dal periodo statistico selezionato.' | split: '|' -%}

    {%- else -%}
      {%- assign words = 'LAATST GEHOORD|Soorten|Detecties|Zekerheid|RECENT|TOPSOORTEN|TOTALEN|Dag|Week|Maand|Alles|Nog geen vogeldetecties.|Geen detecties in deze periode.|BirdWeather niet beschikbaar. Controleer je station-ID.|Aantallen zijn geluidsdetecties.|Vogeldetecties|Los van de gekozen statistiekperiode.' | split: '|' -%}
  {%- endcase -%}

  {%- case key -%}
    {%- when 'last' -%}{{- words[0] -}}
    {%- when 'species' -%}{{- words[1] -}}
    {%- when 'detections' -%}{{- words[2] -}}
    {%- when 'confidence' -%}{{- words[3] -}}
    {%- when 'recent' -%}{{- words[4] -}}
    {%- when 'top' -%}{{- words[5] -}}
    {%- when 'totals' -%}{{- words[6] -}}
    {%- when 'day' -%}{{- words[7] -}}
    {%- when 'week' -%}{{- words[8] -}}
    {%- when 'month' -%}{{- words[9] -}}
    {%- when 'all' -%}{{- words[10] -}}
    {%- when 'empty' -%}{{- words[11] -}}
    {%- when 'empty_period' -%}{{- words[12] -}}
    {%- when 'error' -%}{{- words[13] -}}
    {%- when 'count_note' -%}{{- words[14] -}}
    {%- when 'bird_detections' -%}{{- words[15] -}}
    {%- when 'recent_note' -%}{{- words[16] -}}
  {%- endcase -%}
{% endtemplate %}


{% template bw_screen %}
{% assign settings = trmnl.plugin_settings.custom_fields_values %}
{% assign language = settings.bird_language | default: 'nl' %}
{% assign period_key = settings.period | default: 'day' %}
{% assign last = latest_data.detections | first %}
{% assign total = stats_data.detections | plus: 0 %}
{% assign leader = species_data.species | first %}
{% assign maximum = leader.detections.total | plus: 0 %}

{% capture period_label %}{% render 'bw_text', language: language, key: period_key %}{% endcapture %}
{% assign period_label = period_label | strip %}

{% assign name_classes = 'title title--base lg:title--large' %}
{% assign number_classes = 'value value--xxsmall lg:value--xsmall' %}
{% if view == 'full' %}
  {% assign name_classes = 'title title--large lg:title--xlarge' %}
  {% assign number_classes = 'value value--xsmall lg:value--small' %}
{% endif %}

<style>
  .bw-layout {
    align-items: stretch;
    justify-content: flex-start;
  }

  .bw-stage {
    container: bwpanel / size;
    flex: 1 1 0;
    align-self: stretch;
    width: 100%;
    min-width: 0;
    min-height: 0;
  }

  .bw-stage,
  .bw-stage * {
    box-sizing: border-box;
  }

  .bw-board {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    width: 100%;
    height: 100%;
    min-width: 0;
    text-align: left;
  }

  .bw-main,
  .bw-ranking,
  .bw-details {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
    min-width: 0;
  }

  .bw-hero {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr);
    align-items: center;
    gap: 9px;
    min-width: 0;
  }

  .bw-photo {
    display: block;
    width: 60px;
    height: 60px;
    object-fit: contain;
  }

  .bw-name {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    width: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .bw-scientific,
  .bw-confidence {
    display: none;
  }

  .bw-scientific,
  .bw-latin,
  .bw-recent-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bw-totals {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding-top: 6px;
    border-top: 1px solid black;
  }

  .bw-total {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .bw-ranking,
  .bw-recent {
    display: none;
  }

  .bw-list {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    min-width: 0;
  }

  .bw-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 3px 0;
    border-bottom: 1px solid black;
  }

  .bw-species-info {
    width: 100%;
    min-width: 0;
  }

  .bw-species {
    display: block;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bw-count {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    white-space: nowrap;
    text-align: right;
  }

  .bw-thumb,
  .bw-latin,
  .bw-share,
  .bw-bar,
  .bw-note {
    display: none;
  }

  .bw-row.bw-after3,
  .bw-row.bw-after5,
  .bw-row.bw-after7 {
    display: none;
  }

  .bw-recent-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .bw-recent-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 8px;
  }

  .bw-recent-confidence {
    text-align: right;
    white-space: nowrap;
  }

  .bw-footer-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Hoge compacte vlakken: top 3. */
  @container bwpanel (min-height: 300px) {
    .bw-ranking {
      display: flex;
    }

    .bw-confidence {
      display: block;
    }

    .bw-board {
      gap: 10px;
    }
  }

  /* Quadrant X: vijf soorten, zonder wijziging voor OG. */
  @container bwpanel (min-width: 450px) and (min-height: 300px) {
    .bw-row.bw-after3 {
      display: grid;
    }
  }

  /* Meer hoogte: grotere foto en top 5. */
  @container bwpanel (min-height: 410px) {
    .bw-hero {
      grid-template-columns: 1fr;
    }

    .bw-photo {
      width: 100%;
      height: 100px;
    }

    .bw-scientific {
      display: block;
    }

    .bw-row.bw-after3 {
      display: grid;
    }
  }

  /* Hoge halve schermen: top 7. */
  @container bwpanel (min-height: 590px) {
    .bw-photo {
      height: 140px;
    }

    .bw-row.bw-after5 {
      display: grid;
    }

    .bw-row {
      padding: 5px 0;
    }
  }

  /* Brede vlakken: twee kolommen. */
  @container bwpanel (min-width: 600px) {
    .bw-board {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      align-content: start;
      align-items: start;
      gap: 18px;
    }

    .bw-ranking {
      display: flex;
    }

    .bw-row.bw-after3 {
      display: grid;
    }
  }

  /* Full OG en ruime portretvlakken. */
  @container bwpanel (min-width: 600px) and (min-height: 340px) {
    .bw-hero {
      grid-template-columns: 1fr;
    }

    .bw-photo {
      width: 100%;
      height: 100px;
    }

    .bw-scientific,
    .bw-confidence {
      display: block;
    }

    .bw-row.bw-after5,
    .bw-full .bw-row.bw-after7 {
      display: grid;
    }

    .bw-note {
      display: block;
    }
  }

  /* Brede X-schermen. */
  @container bwpanel (min-width: 950px) and (min-height: 280px) {
    .bw-board {
      gap: 24px;
    }

    .bw-hero {
      grid-template-columns: 100px minmax(0, 1fr);
      gap: 12px;
    }

    .bw-photo {
      width: 100px;
      height: 85px;
    }

    .bw-scientific,
    .bw-confidence,
    .bw-share {
      display: block;
    }

    .bw-row.bw-after5 {
      display: grid;
    }

    .bw-recent {
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding-top: 6px;
      border-top: 1px solid black;
    }
  }

  /* Full X landschap. */
  @container bwpanel (min-width: 950px) and (min-height: 500px) {
    .bw-full .bw-hero {
      grid-template-columns: 1fr;
    }

    .bw-full .bw-photo {
      width: 100%;
      height: 170px;
    }

    .bw-full .bw-row {
      grid-template-columns: auto 40px minmax(0, 1fr) auto;
      gap: 9px;
      padding: 4px 0;
    }

    .bw-full .bw-thumb {
      display: block;
      width: 40px;
      height: 36px;
      object-fit: contain;
    }

    .bw-full .bw-latin {
      display: block;
    }

    .bw-full .bw-bar {
      display: block;
      height: 3px;
      margin-top: 3px;
      background: black;
    }

    .bw-full .bw-row.bw-after7 {
      display: grid;
    }
  }

  /* Smalle vlakken: maximaal twee regels per soortnaam. */
  @container bwpanel (max-width: 599px) {
    .bw-species {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      white-space: normal;
      overflow: hidden;
      overflow-wrap: anywhere;
    }
  }

  /* Hoge smalle portretvlakken: top 10. */
  @container bwpanel (min-height: 850px) and (max-width: 599px) {
    .bw-row.bw-after7 {
      display: grid;
    }

    .bw-photo {
      height: 140px;
    }

    .bw-board {
      gap: 12px;
    }

    .bw-row {
      padding: 4px 0;
    }
  }

  /* Half horizontal X landschap. */
  @container bwpanel (min-width: 950px) and (max-height: 400px) {
    .bw-horizontal {
      gap: 20px;
    }

    .bw-horizontal .bw-main,
    .bw-horizontal .bw-ranking {
      gap: 4px;
    }

    .bw-horizontal .bw-hero {
      grid-template-columns: 75px minmax(0, 1fr);
      gap: 10px;
    }

    .bw-horizontal .bw-photo {
      width: 75px;
      height: 65px;
    }

    .bw-horizontal .bw-row {
      padding: 2px 0;
    }

    .bw-horizontal .bw-share,
    .bw-horizontal .bw-note {
      display: none;
    }

    .bw-horizontal .bw-recent {
      gap: 3px;
      padding-top: 4px;
    }

    .bw-horizontal .bw-recent-row:nth-child(n+4) {
      display: none;
    }
  }

 /* Full X portret: volledige breedte en alle tien soorten. */
@container bwpanel (min-width: 600px) and (min-height: 850px) {
  .bw-full {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 14px;
  }

  .bw-full .bw-main,
  .bw-full .bw-ranking {
    width: 100%;
    gap: 7px;
  }

  .bw-full .bw-hero {
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 18px;
  }

  .bw-full .bw-photo {
    width: 160px;
    height: 130px;
  }

  .bw-full .bw-recent {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding-top: 6px;
    border-top: 1px solid black;
  }

  .bw-full .bw-recent-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5px 16px;
  }

  .bw-full .bw-row {
    grid-template-columns: auto 36px minmax(0, 1fr) auto;
    gap: 8px;
    padding: 4px 0;
  }

  .bw-full .bw-thumb {
    display: block;
    width: 36px;
    height: 32px;
    object-fit: contain;
  }

  .bw-full .bw-latin,
  .bw-full .bw-share {
    display: block;
  }

  .bw-full .bw-bar {
    display: block;
    height: 3px;
    margin-top: 3px;
    background: black;
  }

  .bw-full .bw-row.bw-after7 {
    display: grid;
  }

  .bw-full .bw-note {
    display: block;
  }
}
</style>

<div class="layout bw-layout">
  <div class="bw-stage">
    {% if latest_data.success == true and species_data.success == true and stats_data.success == true %}

      <div class="bw-board bw-{{ view | escape }}">
        <div class="bw-main">
          <span class="label label--small lg:label--base">
            {% render 'bw_text', language: language, key: 'last' %}
          </span>

          {% if last %}
            {% assign photo = last.species.imageUrl %}
            {% if photo == blank %}
              {% assign photo = last.species.thumbnailUrl %}
            {% endif %}

            <div class="bw-hero">
              {% if photo != blank %}
                <img
                  src="{{ photo | escape }}"
                  alt="{{ last.species.commonName | escape }}"
                  class="image image-dither bw-photo"
                >
              {% else %}
                <span></span>
              {% endif %}

              <div class="bw-details">
                <span class="{{ name_classes }} bw-name">
                  {{ last.species.commonName | escape }}
                </span>

                <span class="description lg:description--large bw-scientific">
                  {{ last.species.scientificName | escape }}
                </span>

                <span class="label label--small lg:label--base">
                  {{ last.timestamp | date: "%d-%m %H:%M %z" }}
                </span>

                {% if last.confidence != nil %}
                  <span class="label label--small lg:label--base bw-confidence">
                    {% render 'bw_text', language: language, key: 'confidence' %}:
                    {{ last.confidence | times: 100 | round }}%
                  </span>
                {% endif %}
              </div>
            </div>
          {% else %}
            <span class="description lg:description--large">
              {% render 'bw_text', language: language, key: 'empty' %}
            </span>
          {% endif %}

          <div class="bw-totals">
            <div class="bw-total">
              <span class="{{ number_classes }}">
                {{ stats_data.species }}
              </span>
              <span class="label label--small lg:label--base">
                {% render 'bw_text', language: language, key: 'species' %}
                · {{ period_label | escape }}
              </span>
            </div>

            <div class="bw-total">
              <span class="{{ number_classes }}">
                {{ stats_data.detections }}
              </span>
              <span class="label label--small lg:label--base">
                {% render 'bw_text', language: language, key: 'detections' %}
                · {{ period_label | escape }}
              </span>
            </div>
          </div>

          <div class="bw-recent">
            <span class="label label--small lg:label--base">
              {% render 'bw_text', language: language, key: 'recent' %} ·
              {% render 'bw_text', language: language, key: 'confidence' %}
            </span>

            <div class="bw-recent-list">
              {% for detection in latest_data.detections limit: 4 %}
                <div class="bw-recent-row">
                  <span class="label label--small lg:label--base">
                    {{ detection.timestamp | date: "%H:%M" }}
                  </span>

                  <span class="label label--small lg:label--base bw-recent-name">
                    {{ detection.species.commonName | escape }}
                  </span>

                  <span class="label label--small lg:label--base bw-recent-confidence">
                    {% if detection.confidence != nil %}
                      {{ detection.confidence | times: 100 | round }}%
                    {% else %}
                      —
                    {% endif %}
                  </span>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>

        <div class="bw-ranking">
          <span class="label label--small lg:label--base">
            {% render 'bw_text', language: language, key: 'top' %}
            · {{ period_label | escape }}
          </span>

          <div class="bw-list">
            {% for bird in species_data.species limit: 10 %}
              {% assign count = bird.detections.total | plus: 0 %}
              {% assign share = 0 %}
              {% assign bar = 0 %}

              {% if total > 0 %}
                {% assign share = count | times: 100.0 | divided_by: total | round: 1 %}
              {% endif %}

              {% if maximum > 0 %}
                {% assign bar = count | times: 100.0 | divided_by: maximum | round %}
              {% endif %}

              {% assign thumb = bird.thumbnailUrl %}
              {% if thumb == blank %}
                {% assign thumb = bird.imageUrl %}
              {% endif %}

              <div class="bw-row {% if forloop.index > 7 %}bw-after7{% elsif forloop.index > 5 %}bw-after5{% elsif forloop.index > 3 %}bw-after3{% endif %}">
                <span class="label label--small lg:label--base">
                  {{ forloop.index }}
                </span>

                {% if thumb != blank %}
                  <img
                    src="{{ thumb | escape }}"
                    alt="{{ bird.commonName | escape }}"
                    class="image image-dither bw-thumb"
                  >
                {% else %}
                  <span class="bw-thumb"></span>
                {% endif %}

                <div class="bw-species-info">
                  <span class="title title--small lg:title--base bw-species">
                    {{ bird.commonName | escape }}
                  </span>

                  <span class="description bw-latin">
                    {{ bird.scientificName | escape }}
                  </span>

                  <div
                    class="bw-bar"
                    style="width: {{ bar }}%;"
                  ></div>
                </div>

                <div class="bw-count">
                  <span class="label label--base lg:label--large">
                    {{ count }}×
                  </span>
                  <span class="label label--small lg:label--base bw-share">
                    {{ share }}%
                  </span>
                </div>
              </div>
            {% else %}
              <span class="description lg:description--large">
                {% render 'bw_text', language: language, key: 'empty_period' %}
              </span>
            {% endfor %}
          </div>

          <span class="description bw-note">
            {% render 'bw_text', language: language, key: 'count_note' %}
          </span>
        </div>
      </div>

    {% else %}
      <span class="description lg:description--large">
        {% render 'bw_text', language: language, key: 'error' %}
      </span>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title bw-footer-name">
    BirdWeather
    {% if view == 'full' or view == 'horizontal' %}
      · {{ settings.station_name | escape }}
    {% endif %}
  </span>
  <span class="instance">{{ period_label | escape }}</span>
</div>
{% endtemplate %}